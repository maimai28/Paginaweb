# Contraseña del panel de administración (/admin). Usa una larga y única.
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-larga
# Carpeta donde se guardan la base de datos y los PDF subidos (debe ser persistente en producción).
DATA_DIR=./data
# Puerto del servidor
PORT=3000
# Tamaño máximo de cada PDF en MB
MAX_PDF_MB=50
